# Neon → tab Prisma (không dùng tab .env.local)
# DATABASE_URL = pooled URL, thêm pgbouncer=true
# DIRECT_URL   = DATABASE_URL_UNPOOLED (host không có -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Vercel Blob (Storage → Blob → BLOB_READ_WRITE_TOKEN)
BLOB_READ_WRITE_TOKEN=""

# Hoặc Cloudinary
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
